PORT=4000
NODE_ENV=development

# Copy this file to .env and fill in your local MySQL values.
# Do not commit .env.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=raja_nursing_home

# Optional. Used only when running npm run db:seed / db:setup.
# Default if unset: ChangeMe@123
# SEED_ADMIN_PASSWORD=ChangeMe@123

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_NAME=rnh_session
